# Generated by dot2editor
root = true

[*]
resharper_alignment_tab_fill_style = use_spaces
resharper_arrange_this_qualifier_highlighting = error
resharper_bad_indent_highlighting = hint
resharper_enforce_line_ending_style = crlf
resharper_inline_out_variable_declaration_highlighting = suggestion
resharper_suggest_use_var_keyword_evident_highlighting = do_not_show
resharper_unused_member_global_highlighting = suggestion
resharper_unused_variable_highlighting = warning

[*.cs]
csharp_prefer_braces = when_multiline
csharp_space_after_cast = false
csharp_style_var_elsewhere = true
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = false
dotnet_diagnostic.CS0109.severity = none
dotnet_naming_rule.instance_fields_protected.severity = warning
dotnet_naming_rule.instance_fields_protected.style = instance_fields_protected_style
dotnet_naming_rule.instance_fields_protected.symbols = instance_fields_protected_symbols
dotnet_naming_rule.interfaces.severity = warning
dotnet_naming_rule.interfaces.style = interfaces_style
dotnet_naming_rule.interfaces.symbols = interfaces_symbols
dotnet_naming_rule.local_constants.severity = none
dotnet_naming_rule.local_constants.style = local_constants_style
dotnet_naming_rule.local_constants.symbols = local_constants_symbols
dotnet_naming_rule.locals.severity = warning
dotnet_naming_rule.locals.style = locals_style
dotnet_naming_rule.locals.symbols = locals_symbols
dotnet_naming_rule.parameters.severity = warning
dotnet_naming_rule.parameters.style = parameters_style
dotnet_naming_rule.parameters.symbols = parameters_symbols
dotnet_naming_rule.private_instance_fields.severity = warning
dotnet_naming_rule.private_instance_fields.style = private_instance_fields_style
dotnet_naming_rule.private_instance_fields.symbols = private_instance_fields_symbols
dotnet_naming_rule.public_constants.severity = warning
dotnet_naming_rule.public_constants.style = public_constants_style
dotnet_naming_rule.public_constants.symbols = public_constants_symbols
dotnet_naming_rule.unity_fields.severity = warning
dotnet_naming_rule.unity_fields.style = unity_fields_style
dotnet_naming_rule.unity_fields.symbols = unity_fields_symbols
dotnet_naming_style.instance_fields_protected_style.capitalization = camel_case
dotnet_naming_style.interfaces_style.capitalization = pascal_case
dotnet_naming_style.interfaces_style.required_prefix = I
dotnet_naming_style.local_constants_style.capitalization = all_upper
dotnet_naming_style.local_constants_style.word_separator = _
dotnet_naming_style.locals_style.capitalization = camel_case
dotnet_naming_style.parameters_style.capitalization = camel_case
dotnet_naming_style.private_instance_fields_style.capitalization = camel_case
dotnet_naming_style.private_instance_fields_style.required_prefix = _
dotnet_naming_style.public_constants_style.capitalization = pascal_case
dotnet_naming_style.unity_fields_style.capitalization = pascal_case
dotnet_naming_symbols.instance_fields_protected_symbols.applicable_accessibilities = protected
dotnet_naming_symbols.instance_fields_protected_symbols.applicable_kinds = field
dotnet_naming_symbols.interfaces_symbols.applicable_accessibilities = *
dotnet_naming_symbols.interfaces_symbols.applicable_kinds = interface
dotnet_naming_symbols.local_constants_symbols.applicable_accessibilities = *
dotnet_naming_symbols.local_constants_symbols.applicable_kinds = local
dotnet_naming_symbols.local_constants_symbols.required_modifiers = const
dotnet_naming_symbols.locals_symbols.applicable_accessibilities = *
dotnet_naming_symbols.locals_symbols.applicable_kinds = local
dotnet_naming_symbols.parameters_symbols.applicable_accessibilities = *
dotnet_naming_symbols.parameters_symbols.applicable_kinds = parameter
dotnet_naming_symbols.private_instance_fields_symbols.applicable_accessibilities = private
dotnet_naming_symbols.private_instance_fields_symbols.applicable_kinds = field
dotnet_naming_symbols.public_constants_symbols.applicable_accessibilities = public, internal
dotnet_naming_symbols.public_constants_symbols.applicable_kinds = field
dotnet_naming_symbols.public_constants_symbols.required_modifiers = const, static
dotnet_naming_symbols.unity_fields_symbols.applicable_accessibilities = public
dotnet_naming_symbols.unity_fields_symbols.applicable_kinds = property
dotnet_style_predefined_type_for_locals_parameters_members = true
dotnet_style_predefined_type_for_member_access = false
dotnet_style_qualification_for_event = false
dotnet_style_qualification_for_field = true
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_property = true
indent_size = 4
indent_style = space
max_line_length = 120
resharper_csharp_add_imports_to_deepest_scope = true
resharper_csharp_align_linq_query = true
resharper_csharp_allow_alias = false
resharper_csharp_anonymous_method_declaration_braces = next_line
resharper_csharp_blank_lines_around_type = 1
resharper_csharp_braces_for_foreach = required_for_multiline_statement
resharper_csharp_braces_for_while = required_for_multiline
resharper_csharp_continuous_indent_multiplier = 1.5
resharper_csharp_instance_members_qualify_declared_in = 0
resharper_csharp_prefer_explicit_discard_declaration = true
resharper_xmldoc_indent_size = 2
resharper_xmldoc_indent_subtags = zero_indent
tab_width = 4

[*.css]
resharper_css_indent_size = 2

[*.proto]
resharper_protobuf_indent_size = 2

[*.resx]
resharper_resx_indent_size = 2

[*.shader]
resharper_shaderlab_brace_style = next_line

[*.vb]
dotnet_naming_rule.method.severity = warning
dotnet_naming_rule.method.style = method_style
dotnet_naming_rule.method.symbols = method_symbols
dotnet_naming_style.method_style.capitalization = pascal_case
dotnet_naming_symbols.method_symbols.applicable_accessibilities = *
dotnet_naming_symbols.method_symbols.applicable_kinds = method
resharper_vb_indent_size = 4

[*.{c,c++,cc,cpp,cxx,h,h++,hh,hpp,hxx}]
resharper_cpp_braces_for_ifelse = required_for_multiline
resharper_cpp_indent_comment = false
resharper_cpp_namespace_indentation = none

[*.{html,htm}]
resharper_html_indent_size = 2
resharper_html_max_blank_lines_between_tags = 1
resharper_html_tags_are_not_indented_inside = 

[*.{js,jsx}]
resharper_js_align_multiple_declaration = true
resharper_js_indent_size = 2

[*.{razor,cshtml}]
resharper_razor_prefer_qualified_reference = false

[*.{ts,tsx}]
resharper_js_no_implicit_any = true

[*.{xml,xsd,xsl,xslt,config,csproj,props,targets,nuspec,ruleset}]
resharper_xml_attribute_style = on_different_lines
resharper_xml_indent_size = 2
